{
  "manifest_version": 3,
  "name": "SharePoint Utility",
  "version": "1.16.0",
  "description": "SharePoint tools for site owners: $batch requests, export and compare sites, navigation, list permissions, search schema.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.sharepoint.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open SharePoint Utility",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
